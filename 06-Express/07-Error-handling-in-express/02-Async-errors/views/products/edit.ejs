<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit-<%= products.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6 mx-auto bg-white p-4 rounded shadow">
                <h1 class="mb-4 text-warning">Edit <%= products.name %></h1>
                
                <!-- method-override for PUT -->
                <form action="/products/<%= products._id %>?_method=PUT" method="post"> 
                    <div class="mb-3">
                        <label for="name" class="form-label">Product Name:</label>
                        <input type="text" name="name" id="name" class="form-control" value="<%= products.name %>" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="price" class="form-label">Price ($):</label>
                        <input type="number" step="0.01" name="price" id="price" class="form-control" value="<%= products.price %>" required>
                    </div>
                    
                    <div class="mb-4">
                        <label for="category" class="form-label">Category:</label>
                        <select name="category" id="category" class="form-select">
                            <% for(let c of categories) { %>
                                <option value="<%= c %>" <%= products.category === c ? 'selected' : '' %>><%= c %></option>
                            <% } %>
                        </select>
                    </div>
                    
                    <button class="btn btn-warning w-100 mb-3">Save Changes</button>
                </form>

                <a href="/products/<%= products._id %>" class="text-secondary text-decoration-none">&larr; Cancel</a>
            </div>
        </div>
    </div>
</body>
</html>