<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new products</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6 mx-auto bg-white p-4 rounded shadow">
                <h1 class="mb-4 text-success">Add a New Product</h1>
                
                <form action="/products" method="post">
                    <div class="mb-3">
                        <label for="name" class="form-label">Product Name:</label>
                        <input type="text" name="name" id="name" class="form-control" placeholder="Enter product name" required>
                    </div>
                    
                    <div class="mb-3">
                        <label for="price" class="form-label">Price ($):</label>
                        <!-- step="0.01" allows decimals -->
                        <input type="number" step="0.01" name="price" id="price" class="form-control" placeholder="0.00" required>
                    </div>
                    
                    <div class="mb-4">
                        <label for="category" class="form-label">Category:</label>
                        <select name="category" id="category" class="form-select">
                            <!-- Populate categories from index.js array -->
                            <% for(let c of categories) { %>
                                <option value="<%= c %>"><%= c %></option>
                            <% } %>
                        </select>
                    </div>
                    
                    <button class="btn btn-success w-100 mb-3">Submit Product</button>
                </form>

                <a href="/products" class="text-secondary text-decoration-none">&larr; Cancel and go back</a>
            </div>
        </div>
    </div>
</body>
</html>