<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit-<%= products.name %></title>
</head>
<body>
    <h1>Edit <%= products.name %> info.</h1>
    <form action="/products/<%= products._id %>?_method=PUT" method="post">     <!-- use PUT method to update a resource -->
         <label for="productName">Product:</label>
        <input type="text" name="name" id="name" placeholder="enter your product" value="<%= products.name %>">
        <label for="price">Price:</label>
        <input type="number" name="price" id="price" placeholder="enter your price" value="<%= products.price %>">
        <label for="category">Category</label>
        <select name="category" id="category">
            <option value="default" selected>select category</option>
            <option value="fruit">fruit</option>
            <option value="vegetable">vegetable</option>
            <option value="dairy">dairy</option>
        </select>
        <button>Submit</button>
    </form>

    <a href="/products/<%= products._id %>">cancel</a>
</body>
</html>