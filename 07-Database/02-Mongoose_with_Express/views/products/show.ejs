<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= products.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow" style="width: 25rem;">
            <div class="card-body">
                <h2 class="card-title"><%= products.name %></h2>
                <h4 class="card-subtitle mb-3 text-muted">$<%= products.price %></h4>
                
                <p class="card-text">
                    Category: 
                    <a href="/products/?category=<%= products.category %>" class="badge bg-info text-dark text-decoration-none">
                        <%= products.category %>
                    </a>
                </p>
                
                <div class="d-flex gap-2 mt-4"> 
                    <a href="/products" class="btn btn-outline-secondary">Back</a>
                    <a href="/products/<%= products._id %>/edit" class="btn btn-warning">Edit</a>
                    
                    <!-- method-override for DELETE -->
                    <form action="/products/<%= products._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>