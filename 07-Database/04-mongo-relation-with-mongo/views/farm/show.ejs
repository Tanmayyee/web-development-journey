<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= farm.name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow" style="width: 25rem;">
            <div class="card-body">
                <h2 class="card-title"><%= farm.name %></h2>
                <h4 class="card-subtitle mb-3 text-muted">city: <%= farm.city %></h4>
                <h4 class="card-subtitle mb-3 text-muted">email: <%= farm.email %></h4>
                
                <div class="d-flex gap-2 mt-4"> 
                    <a href="/farm" class="btn btn-outline-secondary">Back</a>
                    <a href="/farm/<%= farm._id %>/edit" class="btn btn-warning">Edit</a>
                    
                   
                </div>
            </div>
        </div>
    </div>
</body>
</html>