<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All farms</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light"> 
    <div class="container mt-5"> 
        <h1 class="mb-4 text-primary">Farms</h1>

        <ul class="list-group mb-4 w-50 shadow-sm">
            <% for(let farm of farms) { %>
                 <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a href="/products/<%= farm._id %>" class="text-decoration-none text-dark fw-bold">
                        <%= farm.name %>
                    </a>
                    <span class="badge bg-success rounded-pill">$<%= farm.city %></span>
                 </li>
            <% } %>
        </ul>

        <a href="/farm/new" class="btn btn-primary">Add New Farms</a>
        <a href="/prodcuts/new" class="btn btn-primary">Add new prodcuts</a>
        
    </div>
</body>
</html>